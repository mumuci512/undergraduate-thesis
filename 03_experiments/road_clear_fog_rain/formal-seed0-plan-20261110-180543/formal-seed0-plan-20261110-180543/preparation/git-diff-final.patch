@@ -69,3 +69,76 @@ def convert(source_path, output, stages=('ft', 'gsmf')):
     report['status']='PASS'
     write_json(out/'conversion.json',report)
     return report
+
+
+def validate_rain_input(checkpoint, method, work, resume):
+    """A new C stage accepts only conversion; resume accepts only its own C run."""
+    meta = checkpoint.get('meta', {})
+    if meta.get('road_domain') != 'C' or meta.get('road_stage') != method:
+        raise ValueError('Rain input must identify the same method and domain C; Fog resume forbidden')
+    if resume:
+        if meta.get('initialization_only') is not False or meta.get('road_run') != str(Path(work).resolve()):
+            raise ValueError('Resume requires a checkpoint from this exact Rain run')
+    elif meta.get('initialization_only') is not True or any(
+            k in checkpoint for k in ('optimizer', 'param_schedulers')) or 'iter' in meta:
+        raise ValueError('New Rain stage requires a pristine initialization without training state')
+
+
+def convert_incremental(parent_path, output, method, expected_sha256):
+    """Clone the parent's deployed student, including every persistent buffer."""
+    if method not in ('ft', 'gsmf', 'lwf'):
+        raise ValueError(method)
+    parent_sha = sha256(parent_path)
+    if parent_sha != expected_sha256:
+        raise ValueError('Parent checkpoint SHA mismatch')
+    out = Path(output)
+    out.mkdir(parents=True, exist_ok=False)
+    parent = torch.load(str(parent_path), map_location='cpu')
+    state = parent['state_dict']
+    model = build(method)
+    assert_state(state, model)
+    del model
+    dual = method != 'ft'
+    source_prefixes = ('backbone_1.', 'decode_head_1.') if dual else ('backbone.', 'decode_head.')
+    deployed = {k:v for k,v in state.items() if k.startswith(source_prefixes)}
+    converted, rows = {}, []
+    for source, value in deployed.items():
+        single = source.replace('backbone_1.', 'backbone.', 1).replace('decode_head_1.', 'decode_head.', 1)
+        targets = [single, source] if dual else [single]
+        for target in targets:
+            converted[target] = value.clone()
+            rows.append(dict(parent_checkpoint_sha256=parent_sha, source=source, target=target,
+                             shape=list(value.shape), dtype=str(value.dtype), sha256=tensor_hash(value)))
+    model = build(method)
+    assert_state(converted, model)
+    assert converted['decode_head.conv_seg.weight'].shape[0] == 19
+    if dual:
+        for source in deployed:
+            teacher = source.replace('backbone_1.', 'backbone.', 1).replace('decode_head_1.', 'decode_head.', 1)
+            assert torch.equal(converted[source], converted[teacher])
+            assert converted[source].data_ptr() != converted[teacher].data_ptr()
+        actual = model.state_dict()
+        for source in deployed:
+            teacher = source.replace('backbone_1.', 'backbone.', 1).replace('decode_head_1.', 'decode_head.', 1)
+            assert actual[source].data_ptr() != actual[teacher].data_ptr()
+    assert all(torch.equal(converted[r['target']], state[r['source']]) for r in rows)
+    meta = dict(parent_checkpoint=str(Path(parent_path).resolve()), parent_sha256=parent_sha,
+                parent_run=str(Path(parent_path).resolve().parent), parent_domain='B', road_domain='C',
+                road_stage=method, initialization_only=True, dataset_meta=dict(classes=CLASSES),
+                conversion='parent deployed student -> fresh teacher and independent student' if dual else 'complete deployed single branch')
+    target = out/(method+'_init.pth')
+    with target.open('xb') as f:
+        torch.save(dict(state_dict=converted, meta=meta), f)
+    loaded = torch.load(str(target), map_location='cpu')
+    assert_state(loaded['state_dict'], model)
+    validate_rain_input(loaded, method, out, False)
+    assert all(torch.equal(loaded['state_dict'][r['target']], state[r['source']]) for r in rows)
+    report = dict(status='PASS', method=method, parent=str(Path(parent_path).resolve()),
+                  parent_sha256=parent_sha, checkpoint=str(target.resolve()), sha256=sha256(target),
+                  deployed_parent_tensors=len(deployed), target_tensors=len(converted), keys=rows,
+                  excluded_parent_keys=sorted(set(state)-set(deployed)),
+                  excluded_training_state=sorted(set(parent)-{'state_dict'}),
+                  missing_keys=[], unexpected_keys=[], shape_mismatches=[], all_values_exact=True,
+                  independent_parameter_and_buffer_storage=True, strict_save_reload=True)
+    write_json(out/'conversion.json', report)
+    return report
